font-family = Iosevka Nerd Font Mono
font-size = 21
theme = gruber_darker_ghostty

window-padding-x = 8
window-padding-y = 0

# background-opacity = 1

macos-titlebar-style = tabs

# shell-integration = detect

adjust-cursor-thickness = 2

split-divider-color = #453d41

unfocused-split-opacity = 1

keybind = super+h=new_split:left
keybind = super+l=new_split:right
keybind = super+k=new_split:up
keybind = super+j=new_split:down

