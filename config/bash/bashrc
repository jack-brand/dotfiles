# If not running interactively, do nothing
[[ -n $PS1 ]] || return


# Options

shopt -s cdspell
shopt -s checkwinsize
shopt -s extglob


# History

HISTFILE="$XDG_CACHE_HOME/bash_history"
HISTCONTROL=ignoredups
HISTSIZE=5000
HISTFILESIZE=5000


# Completion

if [[ -f /etc/bash/bash_completion ]]; then
    source /etc/bash/bash_completion
fi

if [[ -f "$XDG_CONFIG_HOME/bash/bash_completion" ]]; then
    source "$XDG_CONFIG_HOME/bash/bash_completion"
fi


# Prompt

# reset: "\e[0m"
# red: "\e[0;31m"
# green: "\e[0;32m"
# blue: "\e[0;34m"
# magenta: "\e[0;35m"
# brightblack: "\e[0;90m"

VIRTUAL_ENV_DISABLE_PROMPT=1

PS1=$'\n'

# (venv)
#PS1+='${VIRTUAL_ENV:+(\e[0;90m"${VIRTUAL_ENV##*/}")\e[0m) }'
PS1+='\[\e[0;90m\]$([[ -n ${VIRTUAL_ENV:-} ]] && printf "(%s) " "${VIRTUAL_ENV##*/}")\[\e[0m\]'

# [dir]
PS1+='[\w]'

# git_branch
#PS1+='$(branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null); [[ -n $branch ]] && echo "\e[0;90m$branch\e[0m")'

PS1+=$'\n'

# user@host
#PS1+='\u@\h '

# prompt_char
PS1+='\e[0;32m\$\e[0m '


# Aliases

source "$XDG_CONFIG_HOME/shell/aliases.sh"
