// Credit: <https://github.com/waytoabv/Dotfiles/blob/main/.config/fastfetch/config.jsonc>

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "position": "left",
        "height": 16,
        "padding": {
            "right": 1
        }
    },
    "display": {
        "separator": " ",
        "duration": {
            "abbreviation": true,
            "spaceBeforeUnit": "default"
        }
    },
    "modules": [
        {
            "type": "board",
            "key": "├ board",
            "keyColor": "red"
        },
        {
            "type": "cpu",
            "key": "├ cpu",
            "keyColor": "red",
            "format": "{name} ({cores-physical}) {freq-base} {temperature}",
            "temp": true
        },
        {
            "type": "gpu",
            "key": "├󰾲 gpu",
            "keyColor": "red",
            "format": "{name} {dedicated-used} / {dedicated-total} ({dedicated-percentage-num}%) {temperature}",
            "temp": true,
            "driverSpecific": true
        },
        {
            "type": "disk",
            "key": "├ disk",
            "keyColor": "red",
            "folders": "/",
            "format": "{size-used} / {size-total} ({size-percentage}) {filesystem}"
        },
        {
            "type": "physicaldisk",
            "key": "├─",
            "keyColor": "red",
            "format": "{name} {size} {physical-type} {temperature}",
            "temp": true
        },
        {
            "type": "memory",
            "key": "├ ram",
            "keyColor": "red"
        },
        //{
            //"type": "swap",
            //"key": "├ swap",
            //"keyColor": "red"
        //},
        {
            "type": "display",
            "key": "├󰍹 disp",
            "keyColor": "red",
            "format": "{name} {width}x{height} @ {refresh-rate} Hz {inch}\""
        },
        //////////////////////
        {
            "type": "os",
            "key": "├ os",
            "keyColor": "green",
            "format": "{name} {version}"
        },
        {
            "type": "kernel",
            "key": "├ kern",
            "keyColor": "green"
        },
        {
            "type": "packages",
            "key": "├󰏖 pkg",
            "keyColor": "green"
        },
        {
            "type": "shell",
            "key": "├ sh",
            "keyColor": "green"
        },
        {
            "type": "initsystem",
            "key": "├ init",
            "keyColor": "green"
        },
        //////////////////////
        {
            "type": "de",
            "key": "├ de",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "├󰕮 wm",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "├ term",
            "keyColor": "blue"
        },
        {
            "type": "icons",
            "key": "├ icons",
            "keyColor": "blue"
        },
        //////////////////////
        {
            "type": "uptime",
            "key": "├ uptime",
            "keyColor": "magenta"
        }
        //{
        //  "type": "command",
        //  "key": "├󰔟 age",
        //  "keyColor": "magenta",
        //  "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
        //}
    ]
}
