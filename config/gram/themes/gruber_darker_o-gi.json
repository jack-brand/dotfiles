          "string.special": { "color": "#73c936" },
          "string.special.symbol": { "color": "#73c936" },
          "tag": { "color": "#ffdd33" },
          "text.literal": { "color": "#73c936" },
          "title": { "color": "#ffdd33", "font_weight": 700 },
          "type": { "color": "#ffdd33" },
          "type.interface": { "color": "#ffdd33" },
          "variable": { "color": "#e4e4ef" },
          "variable.member": { "color": "#e4e4ef" },
          "variable.parameter": { "color": "#e4e4ef" },
          "variable.special": { "color": "#ffdd33" },
